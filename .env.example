PORT=3000
NODE_ENV=development
DB_PATH=./data/ihqa_call_management.sqlite
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Email / Amazon SES / SMTP Configuration
EMAIL_PROVIDER=dev-json
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="India Holy Quran Award Kerala <coordination@ihqakerala.org>"

# Cloud Telephony Configuration (exotel | twilio | simulated)
TELEPHONY_PROVIDER=simulated
TELEPHONY_WEBHOOK_SECRET=ihqa-webhook-secret
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional SMS / WhatsApp Integration
SMS_PROVIDER=disabled
SMS_API_KEY=
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_KEY=

# Privacy & Retention
CALL_RECORDING_ENABLED=false
DATA_RETENTION_DAYS=365
